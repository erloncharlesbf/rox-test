        {
            "name": "Authentication",
            "description": "APIs for user authentication, registration, and password management. These endpoints handle user access control and account security.",
            "item": [
                {
                    "name": "Register a new user",
                    "request": {
                        "url": {
                            "host": "{{baseUrl}}",
                            "path": "api\/register",
                            "query": [],
                            "raw": "{{baseUrl}}\/api\/register"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application\/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application\/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\"name\":\"John Doe\",\"email\":\"john@example.com\",\"password\":\"password123\",\"password_confirmation\":\"password123\"}"
                        },
                        "description": "Create a new user account with email and password. Returns the user data and an authentication token.",
                        "auth": {
                            "type": "noauth"
                        }
                    },
                    "response": [
                        {
                            "header": [],
                            "code": 201,
                            "body": "{\"message\":\"User registered successfully\",\"user\":{\"id\":1,\"name\":\"John Doe\",\"email\":\"john@example.com\"},\"token\":\"your-api-token\"}",
                            "name": ""
                        },
                        {
                            "header": [],
                            "code": 422,
                            "body": "{\"message\":\"Validation failed\",\"errors\":{\"email\":[\"This email is already registered.\"]}}",
